root = true

# El formato real de JS/JSX/JSON lo decide Prettier (expoideas-app/.prettierrc.json,
# 4 espacios) y el de Java, Spotless (expoideas-api/pom.xml). Esto es solo el
# respaldo para archivos que ninguno de los dos toca.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf
