# Variables para docker-compose.yml. Copia este archivo a .env (ignorado por git)
# y rellena cada valor. Nunca subas el .env al repositorio.

# Puerto del servidor donde se publica la app (http://servidor:PUERTO/expoideas/).
HTTP_PORT=8080

# Contraseñas de MySQL: largas y distintas entre sí.
MYSQL_ROOT_PASSWORD=
DB_PASSWORD=

# Clave para firmar las sesiones. Genera una con: openssl rand -base64 32
JWT_SECRET=

# El primer administrador: se crea al arrancar si todavía no hay ninguno. Entra con
# esa contraseña, que es temporal: la plataforma le pide cambiarla. Después del primer
# arranque las dos se pueden borrar de aquí.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Correo (servidor SMTP de TI). Sin MAIL_HOST la plataforma funciona, pero no
# envía avisos (invitaciones, cuentas creadas, sustentaciones).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@unisimon.edu.co
# URL pública de la app, para los enlaces de los correos: https://<dominio>/expoideas
# Con MAIL_HOST y esta URL, el registro pide verificar el correo y funciona la
# recuperación de contraseña. Vacía, los avisos salen sin enlace y no se pide verificar.
APP_URL=

# Opcionales
# JWT_EXPIRATION=4h
# LOGIN_MAX_FAILED_ATTEMPTS=5
# LOGIN_LOCK_DURATION=5m
# ALLOWED_ORIGINS=https://otro-origen.unisimon.edu.co
# DB_USERNAME=expoideas
# MAIL_AUTH=true
# MAIL_STARTTLS=true
# MAIL_ATTEMPTS=3
# MAIL_RETRY_DELAY=5s
# Para usar las imágenes publicadas en vez de compilar en el servidor (docs/despliegue.md):
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# IDEARIUM_VERSION=<etiqueta de la versión, p. ej. 211162e>
# Espacio libre mínimo en el disco de los archivos: por debajo, /expoideas/salud responde DOWN
# DISK_MIN_FREE=1GB
# Memoria máxima de cada servicio (ajustar a la máquina que dé TI)
# MYSQL_MEMORY=1g
# API_MEMORY=768m
# APP_MEMORY=128m
